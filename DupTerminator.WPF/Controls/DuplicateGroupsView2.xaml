<UserControl x:Class="DupTerminator.WPF.Controls.DuplicateGroupsView2"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:DupTerminator.WPF.Controls"
             xmlns:scm="clr-namespace:System.ComponentModel;assembly=WindowsBase"
             x:Name="Root"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <!-- CollectionViewSource for grouping and sorting -->
        <CollectionViewSource x:Key="GroupedFiles" Source="{Binding ElementName=Root, Path=ExtendedFileInfos}">
            <CollectionViewSource.GroupDescriptions>
                <!-- Group by DuplicateGroup using Checksum -->
                <PropertyGroupDescription PropertyName="CheckSum" />
            </CollectionViewSource.GroupDescriptions>
            <CollectionViewSource.SortDescriptions>
                <!-- Default sort by CheckSum (group), then Name -->
                <scm:SortDescription PropertyName="CheckSum" Direction="Ascending"/>
                <scm:SortDescription PropertyName="Name" Direction="Ascending"/>
            </CollectionViewSource.SortDescriptions>
        </CollectionViewSource>

        <!-- Style for Group Headers -->
        <Style x:Key="GroupHeaderStyle" TargetType="{x:Type GroupItem}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type GroupItem}">
                        <Expander IsExpanded="True">
                            <Expander.Header>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Duplicate Group: " FontWeight="Bold" Margin="0,0,5,0"/>
                                    <TextBlock Text="{Binding Name}" FontWeight="Bold"/>
                                    <TextBlock Text=" (" FontWeight="Bold" Margin="5,0,0,0"/>
                                    <TextBlock Text="{Binding ItemCount}" FontWeight="Bold"/>
                                    <TextBlock Text=" files)" FontWeight="Bold"/>
                                </StackPanel>
                            </Expander.Header>
                            <ItemsPresenter />
                        </Expander>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <DataGrid x:Name="FileDataGrid" 
                  ItemsSource="{Binding Source={StaticResource GroupedFiles}}"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  GridLinesVisibility="Horizontal"
                  AlternatingRowBackground="LightGray"
                  Sorting="DataGrid_Sorting">

            <DataGrid.GroupStyle>
                <GroupStyle ContainerStyle="{StaticResource GroupHeaderStyle}">
                    <GroupStyle.Panel>
                        <ItemsPanelTemplate>
                            <DataGridRowsPresenter/>
                        </ItemsPanelTemplate>
                    </GroupStyle.Panel>
                </GroupStyle>
            </DataGrid.GroupStyle>

            <DataGrid.Columns>
                <!-- Name Column -->
                <DataGridTextColumn Header="Name" 
                                    Binding="{Binding Name}" 
                                    Width="200"
                                    CanUserSort="True"
                                    SortMemberPath="Name"/>

                <!-- Size Column -->
                <DataGridTextColumn Header="Size" 
                                    Binding="{Binding Size, StringFormat='{}{0:N0}'}" 
                                    Width="100"
                                    CanUserSort="True"
                                    SortMemberPath="Size">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="TextAlignment" Value="Right"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <!-- Path Column -->
                <DataGridTextColumn Header="Path" 
                                    Binding="{Binding CombinedPath}" 
                                    Width="*"
                                    CanUserSort="True"
                                    SortMemberPath="CombinedPath"/>

                <!-- Extension Column -->
                <DataGridTextColumn Header="Extension" 
                                    Binding="{Binding Extension}" 
                                    Width="80"
                                    CanUserSort="True"
                                    SortMemberPath="Extension"/>

                <!-- Last Modified Column -->
                <DataGridTextColumn Header="Last Modified" 
                                    Binding="{Binding LastWriteTime, StringFormat='{}{0:yyyy-MM-dd HH:mm:ss}'}" 
                                    Width="150"
                                    CanUserSort="True"
                                    SortMemberPath="LastWriteTime"/>

                <!-- In Archive Column -->
                <DataGridCheckBoxColumn Header="In Archive" 
                                        Binding="{Binding InArchive, Mode=OneWay}" 
                                        Width="80"
                                        IsReadOnly="True"
                                        CanUserSort="True"
                                        SortMemberPath="InArchive"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
