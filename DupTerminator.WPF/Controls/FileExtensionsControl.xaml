<UserControl x:Class="DupTerminator.WPF.Controls.FileExtensionsControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:DupTerminator.WPF.Controls"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Grid.Row="0" Text="File Extensions" FontWeight="Bold" Margin="0,0,0,5"/>

        <!-- ListBox for extensions -->
        <ListBox Grid.Row="1" x:Name="ExtensionsListBox"
                 ItemsSource="{Binding Extensions, RelativeSource={RelativeSource AncestorType=UserControl}}"
                 SelectionMode="Single"
                 Margin="0,0,0,5">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding}"/>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- Control buttons -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Add" Width="75" Margin="0,0,5,0" Click="AddExtension_Click"/>
            <Button Content="Edit" Width="75" Margin="0,0,5,0" Click="EditExtension_Click"/>
            <Button Content="Remove" Width="75" Click="RemoveExtension_Click"/>
        </StackPanel>
    </Grid>
</UserControl>
