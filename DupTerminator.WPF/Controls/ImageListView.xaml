<UserControl x:Class="DupTerminator.WPF.Controls.ImageListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:DupTerminator.WPF.Controls"
             xmlns:vwp="clr-namespace:DupTerminator.WPF.Controls.VirtualizingWrapPanel"
             x:Name="Root"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">

        <ListBox ItemsSource="{Binding Images}"
                 SelectionMode="Single"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" 
                 VirtualizingPanel.IsVirtualizing="True"
             VirtualizingPanel.VirtualizationMode="Recycling">
        <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                <WrapPanel Orientation="Horizontal" />
                <!--<vwp:VirtualizingWrapPanel
                    Orientation="Vertical"
                    SpacingMode="Uniform"
                    StretchItems="False" />-->
            </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
        <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border BorderBrush="LightGray" BorderThickness="1" Margin="5" >
                        <Border.ContextMenu>
                            <ContextMenu  >
                                <MenuItem Header="Open File"
                                  Command="{Binding DataContext.OpenFileCommand, Source={x:Reference Root}}"
                                  CommandParameter="{Binding FileInfo}" />
                                <MenuItem Header="Open container"
                                  Command="{Binding DataContext.OpenContainerCommand, Source={x:Reference Root}}"
                                  CommandParameter="{Binding FileInfo}" />
                            <Separator />
                            <MenuItem Header="Copy path" 
                              Command="{Binding DataContext.CopyPathCommand, Source={x:Reference Root}}" 
                              CommandParameter="{Binding}" />
                            <Separator />
                                <MenuItem Header="Search by this" 
                              Command="{Binding DataContext.SearchByThisCommand, Source={x:Reference Root}}" 
                              CommandParameter="{Binding}" />
                            </ContextMenu>
                        </Border.ContextMenu>
                        <StackPanel>
                            <Image Source="{Binding Thumbnail}" 
                                   Stretch="Uniform"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   ToolTip="{Binding FilePath}"
                                   Width="200" Height="200" />

                            <!-- Image Info -->
                            <StackPanel Background="White"  Orientation="Horizontal">
                                <TextBlock Text="{Binding HammingDistance, Mode=OneWay}" 
                                           HorizontalAlignment="Center"
                                           Margin="0,0,5,0"/>
                                <TextBlock Text="{Binding Dimensions, Mode=OneWay}" 
                                           HorizontalAlignment="Center"
                                           Margin="0,0,5,0"/>

                                <TextBlock Text="{Binding FileName}"
                                       TextTrimming="CharacterEllipsis"
                                       HorizontalAlignment="Center"
                                       MaxWidth="200"
                                       ToolTip="{Binding FilePath}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

</UserControl>
