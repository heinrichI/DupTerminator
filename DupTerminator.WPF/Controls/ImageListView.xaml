<UserControl x:Class="DupTerminator.WPF.Controls.ImageListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:DupTerminator.WPF.Controls"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <ItemsControl ItemsSource="{Binding Images}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border BorderBrush="LightGray" BorderThickness="1" Margin="5">
                        <StackPanel>
                            <Image Source="{Binding Thumbnail}" 
                                   Stretch="Uniform"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                    Width="200" Height="200" />

                            <!-- Image Info -->
                            <StackPanel Background="White"  Orientation="Horizontal">
                                <TextBlock Text="{Binding HammingDistance, Mode=OneWay}" 
                                           HorizontalAlignment="Center"
                                           Margin="0,0,5,0"/>
                                <TextBlock Text="{Binding Dimensions, Mode=OneWay}" 
                                           HorizontalAlignment="Center"
                                           Margin="0,0,5,0"/>

                                <TextBlock Text="{Binding FileName}"
                                       TextTrimming="CharacterEllipsis"
                                       HorizontalAlignment="Center"
                                       MaxWidth="200"
                                       ToolTip="{Binding FilePath}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </ScrollViewer>
    
