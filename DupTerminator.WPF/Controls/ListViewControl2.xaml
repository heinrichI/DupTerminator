<UserControl x:Class="DupTerminator.WPF.Controls.ListViewControl2"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:DupTerminator.WPF.Controls"
             xmlns:converters="clr-namespace:DupTerminator.WPF.Converters"
             xmlns:scm="clr-namespace:System.ComponentModel;assembly=WindowsBase"
             x:Name="Root"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <CollectionViewSource x:Key="GroupedFiles" 
                              Source="{Binding ElementName=Root, Path=ExtendedFileInfos}">
            <CollectionViewSource.GroupDescriptions>
                <PropertyGroupDescription PropertyName="CheckSum" />
            </CollectionViewSource.GroupDescriptions>
        </CollectionViewSource>

        <converters:FileExtensionToIconConverter x:Key="IconConverter"/>
    </UserControl.Resources>

    <DockPanel>
        <!-- Toolbar -->
        <ToolBar DockPanel.Dock="Top">
            <Button Content="Select All"
                    Command="{Binding SelectAllCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
            <Button Content="Deselect All"
                    Command="{Binding DeselectAllCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
            <Button Content="Delete Selected"
                    Command="{Binding DeleteSelectedCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
        </ToolBar>


        <!-- Status Bar -->
        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem>
                <TextBlock Text="{Binding SelectedItemsCount, ElementName=Root}" />
            </StatusBarItem>
        </StatusBar>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Filter Controls -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="5">
                <TextBlock Text="Filter Path:" VerticalAlignment="Center" Margin="5,0"/>
                <TextBox x:Name="txtFirstFilter" Width="200" Margin="5,0"
                     TextChanged="OnFilterTextChanged"/>
            </StackPanel>

            <ListView x:Name="FilesListView" 
                  Grid.Row="1"
                  ItemsSource="{Binding Source={StaticResource GroupedFiles}}"
                  GridViewColumnHeader.Click="GridViewColumnHeaderClickedHandler"
                  VirtualizingStackPanel.IsVirtualizing="True"
                  VirtualizingStackPanel.VirtualizationMode="Recycling"
                  VirtualizingStackPanel.IsVirtualizingWhenGrouping="True"
                  DataContext="{Binding ElementName=Root}" >
                <ListView.GroupStyle>
                    <GroupStyle AlternationCount="2">
                        <GroupStyle.ContainerStyle>
                            <Style TargetType="{x:Type GroupItem}">
                                <Setter Property="Background" Value="White" />
                                <Style.Triggers>
                                    <Trigger Property="ItemsControl.AlternationIndex" Value="0">
                                        <Setter Property="Background" Value="White" />
                                    </Trigger>
                                    <Trigger Property="ItemsControl.AlternationIndex" Value="1">
                                        <Setter Property="Background" Value="#f0f0f0" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </GroupStyle.ContainerStyle>
                    </GroupStyle>
                </ListView.GroupStyle>

                <!-- Handle double-click at ListViewItem level -->
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <EventSetter Event="MouseDoubleClick" Handler="ListViewItem_MouseDoubleClick"/>
                        <!-- Ensure items can receive focus for keyboard commands -->
                        <Setter Property="Focusable" Value="True"/>
                    </Style>
                </ListView.ItemContainerStyle>

                <ListView.InputBindings>
                    <KeyBinding Key="F5"  Command="{Binding SelectAllInFolderCommand}" />
                </ListView.InputBindings>

                <!-- Context menu -->
                <ListView.ContextMenu>
                    <ContextMenu DataContext="{Binding Path=PlacementTarget, RelativeSource={RelativeSource Self}}">
                        <MenuItem Header="Select All" Command="{Binding Path=DataContext.SelectAllCommand}" />
                        <MenuItem Header="Deselect All" Command="{Binding Path=DataContext.DeselectAllCommand}" />
                        <MenuItem Header="Select All in This Folder"
                                  Command="{Binding DataContext.SelectAllInFolderCommand}"
                                  CommandParameter="{Binding Path=SelectedItems}"/>
                        <Separator/>
                        <MenuItem Header="Hide group" Command="{Binding Path=DataContext.HideGroupCommand}" />
                    </ContextMenu>
                </ListView.ContextMenu>
                <ListView.View>
                    <GridView>
                        <!-- Column for the CheckBox -->
                        <GridViewColumn Width="32">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding IsSelected}" 
                                          IsEnabled="{Binding CanBeSelected}"
                                  HorizontalAlignment="Left" 
                                  VerticalAlignment="Center"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>

                        <GridViewColumn Header="Name" Width="Auto">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <!-- Icon + name -->
                                    <StackPanel Orientation="Horizontal">
                                        <Image Height="16"
                                       Source="{Binding Converter={StaticResource IconConverter}}"
                                       Stretch="Uniform"
                                       SnapsToDevicePixels="True"/>
                                        <TextBox Text="{Binding Name, Mode=OneWay}" 
                                             Margin="4,0,0,0"
                                             IsReadOnly="True" 
                                             Background="Transparent" 
                                             BorderBrush="Transparent" 
                                             IsTabStop="False"
                                             BorderThickness="0" >
                                            <TextBox.Style>
                                                <Style TargetType="TextBox">
                                                    <Setter Property="TextDecorations" Value="None"/>
                                                    <Style.Triggers>
                                                        <!-- When IsSelected = True → Strikethrough -->
                                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                            <Setter Property="TextDecorations" Value="Strikethrough"/>
                                                            <!-- Optional: Change foreground color -->
                                                            <Setter Property="Foreground" Value="Gray"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBox.Style>
                                        </TextBox>
                                    </StackPanel>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="Size" DisplayMemberBinding="{Binding Size, Mode=OneWay}" Width="Auto"/>
                        <GridViewColumn Header="Path" Width="Auto">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBox Text="{Binding Path, Mode=OneWay}" 
                                     IsReadOnly="True" 
                                     Background="Transparent" 
                                     BorderBrush="Transparent" 
                                     IsTabStop="False"
                                     BorderThickness="0" >
                                        <TextBox.Style>
                                            <Style TargetType="TextBox">
                                                <Setter Property="TextDecorations" Value="None"/>
                                                <Style.Triggers>
                                                    <!-- When IsSelected = True → Strikethrough -->
                                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                        <Setter Property="TextDecorations" Value="Strikethrough"/>
                                                        <!-- Optional: Change foreground color -->
                                                        <Setter Property="Foreground" Value="Gray"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBox.Style>
                                    </TextBox>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="Extension" DisplayMemberBinding="{Binding Extension, Mode=OneWay}" Width="Auto" />
                    </GridView>
                </ListView.View>
            </ListView>
        </Grid>

    </DockPanel>
</UserControl>