<UserControl x:Class="DupTerminator.WPF.Controls.ListViewControl2"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:DupTerminator.WPF.Controls"
             xmlns:converters="clr-namespace:DupTerminator.WPF.Converters"
             xmlns:scm="clr-namespace:System.ComponentModel;assembly=WindowsBase"
             x:Name="Root"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <CollectionViewSource x:Key="GroupedFiles" 
                              Source="{Binding ElementName=Root, Path=ExtendedFileInfos}">
            <CollectionViewSource.GroupDescriptions>
                <PropertyGroupDescription PropertyName="CheckSum" />
            </CollectionViewSource.GroupDescriptions>
        </CollectionViewSource>

        <converters:FileExtensionToIconConverter x:Key="IconConverter"/>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <!-- Filter Controls -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="5">
            <TextBlock Text="Filter Path:" VerticalAlignment="Center" Margin="5,0"/>
            <TextBox x:Name="txtFirstFilter" Width="200" Margin="5,0"
                     TextChanged="OnFilterTextChanged"/>
        </StackPanel>

        <ListView x:Name="FilesListView" 
                  Grid.Row="1"
                  ItemsSource="{Binding Source={StaticResource GroupedFiles}}"
                  GridViewColumnHeader.Click="GridViewColumnHeaderClickedHandler"
                  VirtualizingStackPanel.IsVirtualizing="True"
                  VirtualizingStackPanel.VirtualizationMode="Recycling"
                  VirtualizingStackPanel.IsVirtualizingWhenGrouping="True"> 
            <ListView.GroupStyle>
                <GroupStyle AlternationCount="2">
                    <GroupStyle.ContainerStyle>
                        <Style TargetType="{x:Type GroupItem}">
                            <Setter Property="Background" Value="White" />
                            <Style.Triggers>
                                <Trigger Property="ItemsControl.AlternationIndex" Value="0">
                                    <Setter Property="Background" Value="White" />
                                </Trigger>
                                <Trigger Property="ItemsControl.AlternationIndex" Value="1">
                                    <Setter Property="Background" Value="#f0f0f0" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </GroupStyle.ContainerStyle>
                </GroupStyle>
            </ListView.GroupStyle>
            <ListView.View>
                <GridView>
                    <!-- Column for the CheckBox -->
                    <GridViewColumn Width="32">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding IsSelected}" 
                                  HorizontalAlignment="Left" 
                                  VerticalAlignment="Center"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>

                    <GridViewColumn Header="Name" Width="Auto">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <!-- Icon + name -->
                                <StackPanel Orientation="Horizontal">
                                    <Image Height="16"
                                       Source="{Binding Converter={StaticResource IconConverter}}"
                                       Stretch="Uniform"
                                       SnapsToDevicePixels="True"/>
                                    <TextBox Text="{Binding Name, Mode=OneWay}" 
                                             Margin="4,0,0,0"
                                             IsReadOnly="True" 
                                             Background="Transparent" 
                                             BorderBrush="Transparent" 
                                             IsTabStop="False"
                                             BorderThickness="0" />
                                </StackPanel>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <!--<GridViewColumn Header="Icon" Width="24">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <Image 
                                        Height="16" 
                                        Source="{Binding Converter={StaticResource IconConverter}}" 
                                        Stretch="Uniform"
                                        SnapsToDevicePixels="True"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="Name" DisplayMemberBinding="{Binding Name, Mode=OneWay}" Width="Auto"/>-->
                    <GridViewColumn Header="Size" DisplayMemberBinding="{Binding Size, Mode=OneWay}" Width="Auto"/>
                    <!--<GridViewColumn Header="Path" DisplayMemberBinding="{Binding Path, Mode=OneWay}" Width="Auto"/>-->
                    <GridViewColumn Header="Path" Width="Auto">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBox Text="{Binding Path, Mode=OneWay}" 
                                     IsReadOnly="True" 
                                     Background="Transparent" 
                                     BorderBrush="Transparent" 
                                     IsTabStop="False"
                                     BorderThickness="0" />
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="Extension" DisplayMemberBinding="{Binding Extension, Mode=OneWay}" Width="Auto" />
                </GridView>
            </ListView.View>
        </ListView>
    </Grid>
</UserControl>