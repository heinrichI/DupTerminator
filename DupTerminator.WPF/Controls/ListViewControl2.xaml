<UserControl x:Class="DupTerminator.WPF.Controls.ListViewControl2"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:DupTerminator.WPF.Controls"
             xmlns:converters="clr-namespace:DupTerminator.WPF.Converters"
             xmlns:scm="clr-namespace:System.ComponentModel;assembly=WindowsBase"
             x:Name="Root"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <CollectionViewSource x:Key="GroupedFiles" Source="{Binding ElementName=Root, Path=ExtendedFileInfos}">
            <CollectionViewSource.GroupDescriptions>
                <PropertyGroupDescription PropertyName="CheckSum" />
            </CollectionViewSource.GroupDescriptions>
        </CollectionViewSource>


    </UserControl.Resources>

    <Grid>
        <ListView x:Name="FilesListView" 
                  ItemsSource="{Binding Source={StaticResource GroupedFiles}}"
                  GridViewColumnHeader.Click="GridViewColumnHeaderClickedHandler">
            <ListView.GroupStyle>
                <GroupStyle AlternationCount="2">
                    <GroupStyle.ContainerStyle>
                        <Style TargetType="{x:Type GroupItem}">
                            <Setter Property="Background" Value="White" />
                            <Style.Triggers>
                                <Trigger Property="ItemsControl.AlternationIndex" Value="0">
                                    <Setter Property="Background" Value="White" />
                                </Trigger>
                                <Trigger Property="ItemsControl.AlternationIndex" Value="1">
                                    <Setter Property="Background" Value="#f0f0f0" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </GroupStyle.ContainerStyle>
                </GroupStyle>
            </ListView.GroupStyle>
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Name" DisplayMemberBinding="{Binding Name}" Width="Auto"/>
                    <GridViewColumn Header="Size" DisplayMemberBinding="{Binding Size}" Width="Auto"/>
                    <GridViewColumn Header="Path" DisplayMemberBinding="{Binding Path}" Width="Auto"/>
                    <GridViewColumn Header="Extension" DisplayMemberBinding="{Binding Extension}" Width="Auto" />
                </GridView>
            </ListView.View>
        </ListView>
    </Grid>
</UserControl>