<Window x:Class="DupTerminator.WPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:behavior="clr-namespace:DupTerminator.WPF.Behavior"
        xmlns:converters="clr-namespace:DupTerminator.WPF.Converters"
        xmlns:controls="clr-namespace:DupTerminator.WPF.Controls"
        xmlns:local="clr-namespace:DupTerminator.WPF"
        xmlns:model="clr-namespace:DupTerminator.BusinessLogic.Model;assembly=DupTerminator.BusinessLogic"
        xmlns:modes="clr-namespace:DupTerminator.BusinessLogic.Model.Modes;assembly=DupTerminator.BusinessLogic"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="booleanToVisibilityConverter" />
        <converters:FileExtensionToIconConverter x:Key="IconConverter"/>
        <converters:FileSizeConverter x:Key="fileSizeConverter"/>

        <DataTemplate DataType="{x:Type modes:MD5ContainerResult}">
            <ListView x:Name="myListView" ItemsSource="{Binding Result}"
                      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                      HorizontalContentAlignment="Stretch">
                <ListView.ItemTemplate>
                    <DataTemplate DataType="{x:Type model:DuplicateContainer}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="0.5*"/>
                                <ColumnDefinition Width="0.5*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding TheyThemselvesAreEqual}" Value="True">
                                            <Setter Property="Background" Value="LightGreen"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>

                            <TextBox Grid.Row="0" Grid.Column="0"
                                Text="{Binding FirstInfo.Path, Mode=OneWay}" 
                                IsReadOnly="True"
                                    TextWrapping="Wrap" >
                                <TextBox.Style>
                                    <Style TargetType="TextBox">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding DataContext.TheyThemselvesAreEqual, RelativeSource={RelativeSource AncestorType=Grid}}" Value="True">
                                                <Setter Property="Background" Value="LightGreen"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBox.Style>
                                <TextBox.InputBindings>
                                    <MouseBinding MouseAction="LeftDoubleClick"
                                    Command="{Binding DataContext.OpenFileCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding FirstInfo}" />
                                </TextBox.InputBindings>
                            </TextBox>
                            <!--<StackPanel Grid.Row="1" Grid.Column="0" Orientation="Horizontal" >
                                <Label Content="{Binding FirstEqualCount}" />
                                <Label Content="/" />
                                <Label Content="{Binding FirstContainerFilesCount}" />
                            </StackPanel>-->
                            <Expander Grid.Row="1" Grid.Column="0" 
                                      Header="{Binding FirstEqualCount}"
                                      IsExpanded="{Binding IsExpanded, ElementName=SecondExpander}" >
                                <Expander.HeaderTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Label Content="{Binding}" />
                                            <Label Content="/" />
                                            <Label Content="{Binding Path=DataContext.FirstContainerFilesCount, RelativeSource={RelativeSource AncestorType=Expander}}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </Expander.HeaderTemplate>

                                <!-- Содержимое выпадающей панели -->
                                <ListBox ItemsSource="{Binding FirstEqualFiles}" 
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                         ScrollViewer.VerticalScrollBarVisibility="Auto">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Name}" ToolTip="{Binding Path}" Margin="2" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Expander>

                            <TextBox  Grid.Row="0" Grid.Column="1"
                                Text="{Binding SecondInfo.Path, Mode=OneWay}" 
                                IsReadOnly="True" TextWrapping="Wrap" >
                                <TextBox.Style>
                                    <Style TargetType="TextBox">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding DataContext.TheyThemselvesAreEqual, RelativeSource={RelativeSource AncestorType=Grid}}" Value="True">
                                                <Setter Property="Background" Value="LightGreen"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBox.Style>
                                <TextBox.InputBindings>
                                    <MouseBinding MouseAction="LeftDoubleClick"
                                    Command="{Binding DataContext.OpenFileCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding SecondInfo}" />
                                </TextBox.InputBindings>
                            </TextBox>
                            <Expander Grid.Row="1" Grid.Column="1" Header="{Binding SeconEqualCount}" 
                                      x:Name="SecondExpander" >
                                <Expander.HeaderTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Label Content="{Binding}" />
                                            <Label Content="/" />
                                            <Label Content="{Binding Path=DataContext.SecondContainerFilesCount, RelativeSource={RelativeSource AncestorType=Expander}}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </Expander.HeaderTemplate>
                                <!-- Содержимое выпадающей панели -->
                                <ListBox ItemsSource="{Binding FirstEqualFiles}" 
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                         ScrollViewer.VerticalScrollBarVisibility="Auto">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Name}" ToolTip="{Binding Path}" Margin="2"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Expander>

                            <TextBox Grid.Row="0" Grid.Column="2"
                                     Text="{Binding SizeOfEqualFiles, Mode=OneWay, Converter={StaticResource fileSizeConverter}}" 
                                     IsReadOnly="True" />                            
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>          
        </DataTemplate>

        <!-- Display for MD5Result -->
        <DataTemplate DataType="{x:Type modes:MD5Result}">
            <!-- <controls:DuplicateGroupsView2 DuplicateGroups="{Binding Result}" />-->
            <controls:ListViewControl2 DuplicateGroups="{Binding Result}" />
        </DataTemplate>

        <DataTemplate DataType="{x:Type modes:PHashResult}">
            <controls:ImageGroupsView DataContext="{Binding DataContext.ImageGroupsViewModel, RelativeSource={RelativeSource AncestorType=Window}}"/>
        </DataTemplate>

        <DataTemplate DataType="{x:Type modes:PHashSearchImageResult}">
            <controls:ImageListView DataContext="{Binding DataContext.ImageListViewModel, RelativeSource={RelativeSource AncestorType=Window}}"/>
        </DataTemplate>


    </Window.Resources>

    <DockPanel>

        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem DockPanel.Dock="Left" >
                <TextBlock Text="Файлов обработано: 0" />
            </StatusBarItem>
            <Separator DockPanel.Dock="Left" />
        </StatusBar>
        
        <TabControl DockPanel.Dock="Top"
                    SelectedIndex="{Binding SelectedTabPageIndex, 
                                    Mode=TwoWay,
                                    UpdateSourceTrigger=PropertyChanged}" >
        <TabItem DataContext="{Binding SettingViewModel}" Header="Settings">
            <Grid >
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition />
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" >
                    <CheckBox Content="Use DB" IsChecked="{Binding UseDB, UpdateSourceTrigger=PropertyChanged}"/>
                    <controls:SizeInputControl SkipLessThan="{Binding SkipLessThan, Mode=TwoWay}"/>
                    <!--<controls:SkipLessThanControl SkipLessThan="{Binding SkipLessThan, Mode=TwoWay}" />-->
                    <controls:SettingsControl Modes="{Binding Modes}" SelectedMode="{Binding SelectedMode, Mode=TwoWay}"></controls:SettingsControl>
                </StackPanel>
                <Label Content="path" Grid.Row="1"/>
                <DataGrid MinHeight="100"
                                Grid.Row="2"
                                AutoGenerateColumns="False"
                                CanUserAddRows="True"
                                CanUserDeleteRows="True"
                                ItemsSource="{Binding Locations, ValidatesOnNotifyDataErrors=True}"
                                IsSynchronizedWithCurrentItem="True"
                               >
                    <i:Interaction.Behaviors>
                        <behavior:FrameworkElementDropBehavior/>
                    </i:Interaction.Behaviors>
                    <DataGrid.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="{DynamicResource mainwindow_tabControl_setting_pathmenu_deletecurrent}" 
                                              Command="{Binding LocationsModel.DeleteCurrentLocationCommand}"
                                              CommandParameter="{Binding}" />
                        </ContextMenu>
                    </DataGrid.ContextMenu>

                    <DataGrid.Columns>
                        <!--<DataGridTemplateColumn Header="{DynamicResource mainwindow_GridColumn_Icon}" >
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Image Source="{Binding Image, Mode=OneWay}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>-->

                        <DataGridTextColumn Binding="{Binding Path, Mode=TwoWay}"
                                                        Header="{DynamicResource mainwindow_GridColumn_Path}"/>
                        <DataGridTemplateColumn Header="{DynamicResource mainwindow_GridColumn_SearchSubfolders}" >
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding SearchInSubfolder, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                   Visibility="{Binding IsDirectory, Converter={StaticResource booleanToVisibilityConverter}}" 
                                                   HorizontalAlignment="Center" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
                <Button Grid.Row="3"
                    Command="{Binding StartCommand}" 
        Content="Start" />
                </Grid>
                </TabItem>

        <TabItem Header="Result">
            <!--<controls:DuplicateGroupsView2 DuplicateGroups="{Binding SearchResults}" /> -->
            <!--<controls:ImageGroupsView 
                                      DataContext="{Binding ImageGroupsViewModel}"/>-->

            <!-- <ContentControl Content="{Binding SearchResults}" />-->
            <ContentControl Content="{Binding SearchResults}" />
