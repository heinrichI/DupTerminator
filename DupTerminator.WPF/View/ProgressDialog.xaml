<Window x:Class="DupTerminator.WPF.View.ProgressDialog"
		xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
		xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
		xmlns:local="clr-namespace:DupTerminator.WPF.View"
		xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
		xmlns:behavior="clr-namespace:DupTerminator.WPF.Behavior"
		xmlns:converters="clr-namespace:DupTerminator.WPF.Converters"
		mc:Ignorable="d"
		Title="ProgressDialog" Height="450" Width="800">

    <!--<Window.Resources>
		<converters:ProgressBarConverter x:Key="progressBarConverter"/>
	</Window.Resources>-->

	<!--ProgressValue Свойство представляется как значение в диапазоне от 0,0 до 1,0-->
	<Window.TaskbarItemInfo>
		<TaskbarItemInfo Description="My Taskbar Sample" ProgressState="Normal" >
			<TaskbarItemInfo.ProgressValue>
				<MultiBinding Converter="{StaticResource progressBarConverter}">
					<Binding Path="Progress" Mode="OneWay"/>
					<Binding Path="ProgressMax" />
				</MultiBinding>
			</TaskbarItemInfo.ProgressValue>
		</TaskbarItemInfo>
	</Window.TaskbarItemInfo>

	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<!--State-->
			<RowDefinition Height="Auto"/>
			<!--ProgressMessage-->
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
			<!--Cancel-->
			<RowDefinition/>
		</Grid.RowDefinitions>

		<TextBlock Grid.Row="0" Text="{Binding Path=State, Mode=OneWay, UpdateSourceTrigger=PropertyChanged}"/>
		<!-- Progress Message -->
		<TextBlock Grid.Row="1" Text="{Binding Path=ProgressMessage, Mode=OneWay, UpdateSourceTrigger=PropertyChanged}"/>
		<ProgressBar Grid.Row="2" Value="{Binding Path=Progress, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
					 Maximum="{Binding Path=ProgressMax, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
					 Height="50"/>
		<Button Grid.Row="3" Content="Cancel"  Command="{Binding Path=CancelCommand}" />
		<!--<TextBlock Text="{Binding Path=LogMessage, Mode=OneWay, UpdateSourceTrigger=PropertyChanged}" 
				   HorizontalAlignment="Center"  />-->

		<DataGrid Grid.Row="4" 
					  ItemsSource="{Binding LogItems}" 
					  x:Name="logGrid"
					  AutoGenerateColumns="False" 
					  IsReadOnly="True"
					  HorizontalScrollBarVisibility="Auto" 
					  VerticalScrollBarVisibility="Auto"
					  IsSynchronizedWithCurrentItem="True" 
				  SelectedItem="{Binding SelectedLogItem, Mode=TwoWay}">
			<i:Interaction.Behaviors>
				<behavior:ScrollOnNewItemBehavior />
			</i:Interaction.Behaviors>
			<DataGrid.Columns>
				<DataGridTextColumn Header="Time" Binding="{Binding Time, Mode=OneWay}" />
				<DataGridTextColumn Header="Message" Binding="{Binding Message, Mode=OneWay}" />
			</DataGrid.Columns>
		</DataGrid>
	</Grid>
</Window>
